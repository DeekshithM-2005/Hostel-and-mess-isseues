# ── Hostel Management System — Environment Variables ──
# Copy this file to .env and fill in your values.

# JWT secret (minimum 32 characters for HS256)
JWT_SECRET=your-production-secret-key-here-must-be-at-least-32-characters

# JWT token expiration in milliseconds (default: 24 hours)
JWT_EXPIRATION=86400000

# MySQL Database (activate with: --spring.profiles.active=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hosteldb
DB_USERNAME=root
DB_PASSWORD=

# File upload directory
UPLOAD_DIR=./uploads

# Server port
SERVER_PORT=8080
